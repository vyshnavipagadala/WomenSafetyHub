<?xml version="1.0" encoding="UTF-8"?>

<web-app
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/jakartaee
        https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
    version="6.0">

    <display-name>WomenSafetyHub</display-name>


    <!-- ========================= -->
    <!-- View Safe Zones Servlet   -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>ViewZonesServlet</servlet-name>
        <servlet-class>com.womensafety.servlet.ViewZonesServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ViewZonesServlet</servlet-name>
        <url-pattern>/view</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- Add Safe Zone Servlet     -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>AddZoneServlet</servlet-name>
        <servlet-class>com.womensafety.servlet.AddZoneServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddZoneServlet</servlet-name>
        <url-pattern>/add</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- Search Servlet             -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>com.womensafety.servlet.SearchServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- Stats Servlet              -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>StatsServlet</servlet-name>
        <servlet-class>com.womensafety.servlet.StatsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>StatsServlet</servlet-name>
        <url-pattern>/stats</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- Location Servlet           -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>LocationServlet</servlet-name>
        <servlet-class>com.womensafety.servlet.LocationServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LocationServlet</servlet-name>
        <url-pattern>/location</url-pattern>
    </servlet-mapping>


<!-- -============== -->
<!-- Delete -->
<servlet>

    <servlet-name>DeleteZoneServlet</servlet-name>

    <servlet-class>
        com.womensafety.servlet.DeleteZoneServlet
    </servlet-class>

</servlet>


<servlet-mapping>

    <servlet-name>DeleteZoneServlet</servlet-name>

    <url-pattern>/delete</url-pattern>

</servlet-mapping>

    <!-- ========================= -->
    <!-- Welcome Page               -->
    <!-- ========================= -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    
   

</web-app>